<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r3_robot">
  <!-- file:// + $(find ...) so Gazebo resolves visuals when spawning URDF (package:// is unreliable). -->
  <xacro:property name="mesh_dir" value="file://$(find orange_description)/URDF/meshes"/>
  <!-- Wheel geometry for diff_drive (meters); center-to-center along y, tire diameter -->
  <xacro:property name="wheel_sep" value="0.8105"/>
  <xacro:property name="wheel_diam" value="0.44"/>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Ground ~ wheel bottom; wheel z -0.074, r=0.22; raise base_link ~0.29 m above footprint -->
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.0374161775948693 -0.00127430901164387 0.0470608642145947" rpy="0 0 0"/>
      <mass value="81.1401446778268"/>
      <inertia ixx="0.728632085236706" ixy="1.32350754415025E-05" ixz="-0.0224859617907878"
        iyy="1.14289496966326" iyz="-7.48148338622692E-05" izz="1.53133782528775"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/base_link.STL"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.136 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.82 0.88 0.38"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_right">
    <inertial>
      <origin xyz="1.798E-05 -0.003577 -1.798E-05" rpy="0 0 0"/>
      <mass value="6.0074"/>
      <inertia ixx="0.11314" ixy="-3.6258E-08" ixz="8.1856E-07" iyy="0.20566" iyz="3.6267E-08" izz="0.11314"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/wheel_right.STL"/>
      </geometry>
      <material name="wheel_blue">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.22" length="0.10"/>
      </geometry>
    </collision>
  </link>
  <joint name="rightWheel" type="continuous">
    <origin xyz="0.25591 0.40526 -0.07445" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="10"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <link name="wheel_left">
    <inertial>
      <origin xyz="-1.798E-05 0.003577 -1.798E-05" rpy="0 0 0"/>
      <mass value="6.0074"/>
      <inertia ixx="0.11314" ixy="-3.6258E-08" ixz="-8.1856E-07" iyy="0.20566" iyz="-3.6267E-08" izz="0.11314"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/wheel_left.STL"/>
      </geometry>
      <material name="wheel_blue_l">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.22" length="0.10"/>
      </geometry>
    </collision>
  </link>
  <joint name="leftWheel" type="continuous">
    <origin xyz="0.25591 -0.40525 -0.07445" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <axis xyz="0 -1 0"/>
    <limit effort="10" velocity="10"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <link name="right_caster">
    <inertial>
      <origin xyz="-0.039652 -5.8101E-05 -0.13418" rpy="0 0 0"/>
      <mass value="1.8501"/>
      <inertia ixx="0.0057433" ixy="2.8684E-08" ixz="-0.00012827" iyy="0.0096143" iyz="8.6762E-08" izz="0.0054708"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/right_caster.STL"/>
      </geometry>
      <material name="caster_grey">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.25"/>
      </geometry>
    </collision>
  </link>
  <joint name="rightCaster" type="continuous">
    <origin xyz="-0.52775 0.24612 -0.03635" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_caster"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="left_caster">
    <inertial>
      <origin xyz="-0.039652 -5.8101E-05 -0.13418" rpy="0 0 0"/>
      <mass value="1.8501"/>
      <inertia ixx="0.0057433" ixy="2.8684E-08" ixz="-0.00012827" iyy="0.0096143" iyz="8.6762E-08" izz="0.0054708"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/left_caster.STL"/>
      </geometry>
      <material name="caster_grey_l">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.25"/>
      </geometry>
    </collision>
  </link>
  <joint name="leftCaster" type="continuous">
    <origin xyz="-0.52775 -0.24612 -0.03635" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_caster"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Same sensor macros as orange_robot_simulation.xacro; tune *origin* for R3 CAD. -->
  <xacro:include filename="$(find orange_description)/xacro/sensors/hokuyo.xacro"/>
  <xacro:include filename="$(find orange_description)/xacro/sensors/imu.xacro"/>
  <xacro:include filename="$(find orange_description)/xacro/sensors/oak_d_pro.xacro"/>

  <xacro:sensor_hokuyo name="hokuyo" parent="base_link" min_angle="-1.22" max_angle="1.22" samples="720">
    <origin xyz="0.40 0 0.35" rpy="0 0 0"/>
  </xacro:sensor_hokuyo>
  <xacro:sensor_imu name="imu" parent="base_link" size="0.05 0.05 0.05">
    <origin xyz="-0.12 0 0.12" rpy="0 0 0"/>
  </xacro:sensor_imu>
  <xacro:oak_d_pro name="oak" parent="base_link">
    <!-- Mounted on the front-right pole, pitched down about 20 degrees -->
    <origin xyz="-0.31 0.0 0.81" rpy="0 0.20 0"/>
  </xacro:oak_d_pro>

  <!-- Wheel / caster friction (matches orange_robot_simulation.gazebo pattern) -->
  <gazebo reference="wheel_left">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="wheel_right">
    <mu1>5.0</mu1>
    <mu2>5.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="left_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="right_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30</update_rate>
      <left_joint>leftWheel</left_joint>
      <right_joint>rightWheel</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_diameter>${wheel_diam}</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>leftWheel</joint_name>
      <joint_name>rightWheel</joint_name>
      <joint_name>leftCaster</joint_name>
      <joint_name>rightCaster</joint_name>
    </plugin>
  </gazebo>
</robot>
