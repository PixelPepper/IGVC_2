<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="debug_viz" default="true"/>
  <arg name="waypoints_viz_file" default="$(find-pkg-share orange_gazebo)/config/waypoints/igvc_course_waypoints.yaml"/>
  
  <!-- Lane Detection Node - Front Camera Only -->
  <node pkg="orange_perception" exec="lane_detector" name="lane_detector" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="debug_viz" value="$(var debug_viz)"/>
    <param name="min_lane_area" value="50"/>
    <param name="max_distance" value="10.0"/>
    <!-- Ray–ground intersection in base_link: match base_joint z (footprint → base_link) in r3_top_assem.xacro -->
    <param name="ground_z_in_base_link" value="-0.24"/>
    <param name="output_frame" value="base_link"/>
  </node>
  
  <!-- Point Cloud Fusion Node -->
  <node pkg="orange_perception" exec="pointcloud_fusion" name="pointcloud_fusion" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="output_frame" value="base_link"/>
    <param name="publish_rate" value="10.0"/>
    <param name="lane_weight" value="8.0"/>  <!-- Tile count for fused_cloud; lower = less costmap overload -->
    <param name="max_range" value="10.0"/>
  </node>
  
  <!-- PointCloud to LaserScan Converter for Nav2 -->
  <node pkg="pointcloud_to_laserscan" exec="pointcloud_to_laserscan_node" name="fused_pointcloud_to_scan">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="cloud_in" to="/fused_cloud"/>
    <remap from="scan" to="/fused_scan"/>
    <param name="min_height" value="-0.5"/>
    <param name="max_height" value="1.0"/>
    <param name="angle_min" value="-1.5708"/>
    <param name="angle_max" value="1.5708"/>
    <param name="angle_increment" value="0.0087"/>
    <param name="scan_time" value="0.1"/>
    <param name="range_min" value="0.2"/>
    <param name="range_max" value="10.0"/>
    <param name="use_inf" value="true"/>
  </node>

  <!-- IGVC course waypoints as nav_msgs/Path for RViz (odom frame; matches navigate_igvc_course.py when YAML is in sync) -->
  <node pkg="orange_perception" exec="waypoint_path_viz" name="waypoint_path_viz" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="waypoints_file" value="$(var waypoints_viz_file)"/>
    <param name="frame_id" value="odom"/>
    <param name="topic" value="igvc_course/waypoints"/>
  </node>

</launch>
